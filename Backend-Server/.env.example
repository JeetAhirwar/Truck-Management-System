# ---------- Server ----------
PORT=5000

# ---------- Database ----------
# MongoDB Atlas (SRV)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/truckpro?appName=Cluster0

# ---------- Auth ----------
JWT_SECRET=change_me_to_a_long_random_string

# ---------- Routing (OSRM - free, no key) ----------
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_TIMEOUT_MS=15000

# ---------- Tolls (TollGuru) ----------
TOLL_API_KEY=your_tollguru_api_key
TOLLGURU_BASE_URL=https://apis.tollguru.com
TOLLGURU_VEHICLE_TYPE=3AxlesTruck
# "true" = polyline endpoint (needs TollTally plan), "false" = waypoints endpoint (free tier)
TOLLGURU_USE_POLYLINE=false
TOLLGURU_TIMEOUT_MS=25000

# ---------- Vehicle RC lookup (cStudios) ----------
# Server-side only. NEVER expose this key with a VITE_ prefix — every VITE_ var
# is inlined into the browser bundle. The key is sent upstream as `X-API-Key`.
# Leave blank while RC_LOOKUP_MODE=mock.
CSTUDIO_API_KEY=
CSTUDIO_RC_BASE_URL=https://api.cstudio.sbs
CSTUDIO_RC_PATH=/v1/rto/vehicle-info
CSTUDIO_RC_TIMEOUT_MS=15000
# "mock" (default) = documented cStudio sample, no external call, no key needed.
# "live"          = real API call; requires CSTUDIO_API_KEY. Successful lookups
#                   are cached in Mongo (see below) because the free plan is
#                   limited to 10 requests/month.
RC_LOOKUP_MODE=mock
# Cache window for live RC lookups (days).
RC_LOOKUP_CACHE_DAYS=30

# ---------- Cloudinary (document uploads) ----------
# When all three are set, uploads go to Cloudinary.
# Leave blank to fall back to local disk at Backend-Server/uploads (dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# "auto" (default) | "cloudinary" | "local" — "local" forces disk storage
# even when the keys above are present.
DOCUMENT_STORAGE=auto

# ---------- Extras ----------
MAP_API_KEY=
